# PostgreSQL connection string (Neon, Supabase, Vercel Postgres, or local PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/ora_egypt_travel?schema=public"

# JWT Secret for Admin Dashboard authentication (use a long random string in production)
JWT_SECRET="replace-with-a-strong-random-secret-key-min-32-chars"

# Default Admin account created when running `npm run db:seed`
ADMIN_EMAIL="admin@oraegypttravel.com"
ADMIN_PASSWORD="ChangeMe123!"

# Local API Server Port
PORT=5000
